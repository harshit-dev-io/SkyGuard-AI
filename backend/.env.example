# =============================================================================
# SkyGuard AI - Production Environment Configuration
# =============================================================================
# Copy this file to .env and customize values for your deployment environment.
# For Railway deployment, these can be set directly in the Railway Project Variables.

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER SETTINGS
# -----------------------------------------------------------------------------
PROJECT_NAME="SkyGuard AI Weather Ingestion Platform"
API_V1_PREFIX=/api/v1
# In Railway or container runtimes, PORT is dynamically supplied (default: 8000)
PORT=8000

# -----------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Generate a strong 256-bit secret key in production (e.g., `openssl rand -hex 32`)
SECRET_KEY=9a4f20c8e13769c8b74619d84e1b8b20984920c789123b0981e6490e21a8f903
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PBKDF2 Password Hashing Parameters
PBKDF2_ITERATIONS=600000
PBKDF2_SALT_SIZE=16

# -----------------------------------------------------------------------------
# 3. TIMESCALEDB / POSTGRESQL + POSTGIS STORAGE
# -----------------------------------------------------------------------------
# In Railway: If using Railway PostgreSQL, set DATABASE_URL to the provided Postgres URL.
# Note: For asyncpg, the application automatically handles "postgres://" or "postgresql://" conversion.
# For Docker Compose, use host 'timescaledb' or 'localhost' when connecting from host.
POSTGRES_USER=skyguard_admin
POSTGRES_PASSWORD=skyguard_secure_pwd
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=skyguard

# Async SQLAlchemy connection URL (used by FastAPI core API)
DATABASE_URL=postgresql+asyncpg://skyguard_admin:skyguard_secure_pwd@timescaledb:5432/skyguard

# Synchronous SQLAlchemy connection URL (used by Celery workers)
DATABASE_SYNC_URL=postgresql+psycopg2://skyguard_admin:skyguard_secure_pwd@timescaledb:5432/skyguard

# Database connection pool tuning
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# 4. REDIS BUFFER, QUARANTINE & CACHE
# -----------------------------------------------------------------------------
# For Docker Compose: REDIS_HOST=redis
# For Railway / Upstash: set REDIS_HOST to provided cloud host and REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=skyguard_redis_pwd
REDIS_IS_CLUSTER=false

# Deduplication and time-drift constraints
DEDUP_TTL_SECONDS=86400
DEJITTER_WINDOW_SECONDS=30.0
CLOCK_DRIFT_MAX_BACKWARD_SECONDS=-10.0
CLOCK_DRIFT_MAX_FORWARD_SECONDS=300.0

# Hardware Fault Quarantine Configuration
QUARANTINE_REDIS_SET_KEY=stations:under_correction
QUARANTINE_TTL_SECONDS=7200

# -----------------------------------------------------------------------------
# 5. CELERY ASYNCHRONOUS WORKER & BEAT SCHEDULER
# -----------------------------------------------------------------------------
# Celery Broker and Result Backend using Redis DB 1 and 2
CELERY_BROKER_URL=redis://:skyguard_redis_pwd@redis:6379/1
CELERY_RESULT_BACKEND=redis://:skyguard_redis_pwd@redis:6379/2
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# -----------------------------------------------------------------------------
# 6. APACHE KAFKA DISTRIBUTED EVENT STREAMING
# -----------------------------------------------------------------------------
# Local Docker Compose: KAFKA_BOOTSTRAP_SERVERS=kafka:9092, KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Managed Cloud (Aiven / Confluent): Set KAFKA_SECURITY_PROTOCOL=SASL_SSL and provide credentials
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=your_kafka_secret_password

# Kafka Consumer Groups & Client Identification
KAFKA_CLIENT_ID=skyguard-ingest-substrate
KAFKA_CONSUMER_GROUP=skyguard-raw-ingestion-workers
KAFKA_GROUP_ID=skyguard-evidence-engines-flock
KAFKA_FUSION_GROUP_ID=skyguard-fusion-classifier-group

# -----------------------------------------------------------------------------
# 7. KAFKA TOPIC DEFINITIONS
# -----------------------------------------------------------------------------
KAFKA_TOPIC_RAW_OBSERVATIONS=observations.raw
KAFKA_TOPIC_DEAD_LETTER=observations.deadletter
TOPIC_EVIDENCE_TEMPORAL=evidence.temporal
TOPIC_EVIDENCE_SPATIAL=evidence.spatial
TOPIC_EVIDENCE_EVENT=evidence.event
TOPIC_EVIDENCE_HEALTH=evidence.health
TOPIC_FUSED_BUNDLES=bundles.fused
TOPIC_CLASSIFICATION_OUTPUT=classifications.state_fault

# -----------------------------------------------------------------------------
# 8. MQTT BROKER (EDGE TELEMETRY & WIS2 WNM NOTIFICATIONS)
# -----------------------------------------------------------------------------
# Local Docker Compose: MQTT_BROKER_HOST=mosquitto
# Production: Set to your managed MQTT broker (e.g. EMQX Cloud, HiveMQ, AWS IoT)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# -----------------------------------------------------------------------------
# 9. WMO WIS2 GLOBAL BROKER & BUFR STORAGE INTEGRATION
# -----------------------------------------------------------------------------
WIS2_CENTRE_ID=in-imd-delhi
WIS2_GB_HOST=mosquitto
WIS2_GB_PORT=1883
WIS2_STORAGE_DIR=/app/data/wis2_objects
WIS2_BASE_URL=http://localhost:8000/api/v1/wis2/data

# -----------------------------------------------------------------------------
# 10. EVIDENCE GENERATION & STREAMING FUSION ENGINE
# -----------------------------------------------------------------------------
FUSION_JOIN_TIMEOUT_SECONDS=2.0
EVIDENCE_DEGRADE_ALLOWED=True
ACTIVE_LEARNING_UNCERTAINTY_THRESHOLD=0.70
SPARSE_CLASS_SAMPLE_THRESHOLD=50
CALIBRATION_BINS=10

# Apache Flink Topology Settings
FLINK_PARALLELISM=4
CHECKPOINT_INTERVAL_MS=15000
CHECKPOINT_TIMEOUT_MS=60000
MIN_PAUSE_BETWEEN_CHECKPOINTS_MS=5000

# Event and Health Evidence Windows
EVENT_CORROBORATION_WINDOW_SECONDS=300
HEALTH_STREAM_BLOCK_SIZE=60
HEALTH_MAX_BUFFERED_BLOCKS=48

# -----------------------------------------------------------------------------
# 11. SELF-HEALING GATES & PHYSICAL CONSTRAINTS
# -----------------------------------------------------------------------------
# Gate 1: Confirmed Hardware Fault Constraints
MIN_CLASSIFICATION_PROBABILITY=0.85

# Gate 2: State Estimate Trustworthiness
CHI2_INNOVATION_ALPHA_THRESHOLD=6.635

# Gate 3: Bounded Uncertainty Constraints
MAX_ALLOWABLE_POSTERIOR_SIGMA=1.25

# Gate 4: Spatial Neighbor Constraints
MIN_REQUIRED_CLEAN_NEIGHBORS=2
MAX_NEIGHBOR_DISTANCE_KM=45.0

# -----------------------------------------------------------------------------
# 12. UNSCENTED KALMAN FILTER (UKF) DYNAMICS & ADAPTIVE CALIBRATION
# -----------------------------------------------------------------------------
UKF_MODEL_VERSION=ukf-v2.1
UKF_ALPHA=0.001
UKF_BETA=2.0
UKF_KAPPA=0.0
UKF_PROCESS_NOISE_Q=0.04
UKF_DEFAULT_MEASUREMENT_NOISE_R=0.36

ADAPTIVE_UKF_INNOVATION_ALPHA_LOW=0.50
ADAPTIVE_UKF_INNOVATION_ALPHA_HIGH=2.50
ADAPTIVE_UKF_Q_STEP_UP=1.25
ADAPTIVE_UKF_Q_STEP_DOWN=0.85
MAX_ALLOWABLE_ECE=0.08

# -----------------------------------------------------------------------------
# 13. REMAINING USEFUL LIFE (RUL) & SPATIAL TOPOLOGY WORKER
# -----------------------------------------------------------------------------
LOAD_SHEDDING_LAG_THRESHOLD=5000
LOAD_SHEDDING_RECOVERY_THRESHOLD=500
LOAD_SHEDDING_PROBE_INTERVAL_SECONDS=30

RUL_ESTIMATOR_VERSION=rul-v2.0
RUL_TEMPERATURE_MAX_DRIFT_CELSIUS=2.5
RUL_PRESSURE_MAX_DRIFT_HPA=4.0
RUL_HUMIDITY_MAX_DRIFT_PERCENT=8.0
RUL_MIN_DATA_POINTS=144

TOPOLOGY_H3_RESOLUTION=6
TOPOLOGY_DEFAULT_K_NEIGHBORS=8
TOPOLOGY_MAX_DISTANCE_KM=50.0

REWIND_DEFAULT_LOOKBACK_HOURS=72
REWIND_BATCH_CHUNK_SIZE=1000

# -----------------------------------------------------------------------------
# 14. OPTIONAL AI & CLOUD SERVICES
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 15. CARTO BASEMAP CONFIGURATION (Optional backend tile proxy)
# -----------------------------------------------------------------------------
CARTO_API_KEY=
CARTO_STYLE=dark_all